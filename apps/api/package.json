{
  "name": "@reserveflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts src/lib/*.test.ts",
    "db:migrate": "tsx src/db.ts",
    "db:seed": "tsx src/seed.ts",
    "test:integration": "tsx --test src/integration.test.ts"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "6.0.2"
  }
}
